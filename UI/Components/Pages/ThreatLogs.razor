@page "/threatlogs"
@rendermode InteractiveServer
@inject UI.Services.TalonApiClient Api
@inject NavigationManager Navigation

<h1>Threats & security audit</h1>
@if (!Api.IsLoggedIn)
{
    <p>Log in to view tenant threat logs.</p><a class="btn btn-primary" href="/login">Log in</a>
}
else if (loading) { <p>Loading timeline...</p> }
else if (error is not null) { <div class="alert alert-danger">@error</div> }
else
{
    <div class="card mb-3"><div class="card-body"><strong>Tenant:</strong> @Api.CurrentTenantName<br /><strong>Role:</strong> @Api.CurrentTenantRole</div></div>
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Filter</label>
            <select class="form-select" @bind="selectedFilter">
                <option value="all">All</option>
                <option value="threats">Threats only</option>
                <option value="audit">Security audit only</option>
                <option value="high-critical">High + critical only</option>
            </select>
        </div>
        <div class="col-md-3"><label class="form-label">Since</label><InputDate class="form-control" @bind-Value="sinceDate" /></div>
        <div class="col-md-2"><button class="btn btn-primary" @onclick="LoadAsync">Apply filter</button></div>
    </div>
    @if (timeline.Count == 0) { <p>No matching threat or audit events for this tenant.</p> }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Type</th>
                    <th>Severity</th>
                    <th>Event</th>
                    <th>Source IP</th>
                    <th>Country</th>
                    <th>Request path</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in timeline)
            {
                <tr>
                    <td>@item.OccurredAt.ToLocalTime()</td>
                    <td><span class="badge bg-secondary">@item.RecordType</span></td>
                    <td><span class="badge @SeverityClass(item.Severity)">@SeverityName(item.Severity)</span></td>
                    <td>@item.EventType</td>
                    <td>@(string.IsNullOrWhiteSpace(item.SourceIp) ? "-" : item.SourceIp)</td>
                    <td>@(string.IsNullOrWhiteSpace(item.CountryCode) || item.CountryCode == "ZZ" ? "Unknown" : item.CountryCode)</td>
                    <td>@(string.IsNullOrWhiteSpace(item.RequestPath) ? "-" : item.RequestPath)</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Details) ? "-" : item.Details)</td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@code {
    private bool loading = true;
    private string? error;
    private DateTime? sinceDate;
    private string selectedFilter = "all";
    private IReadOnlyList<UI.Services.TalonApiClient.TimelineItem> timeline = Array.Empty<UI.Services.TalonApiClient.TimelineItem>();
    private bool restored;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || restored) return;
        restored = true;
        await Api.RestoreAuthAsync();
        if (!Api.IsLoggedIn) { loading = false; Navigation.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            var items = await Api.GetTimelineAsync(MapFilter(selectedFilter), sinceDate?.Date)
                ?? throw new InvalidOperationException("Threat-log timeline request failed.");

            timeline = items
                .Where(x => selectedFilter switch
                {
                    "threats" => x.RecordType == "ThreatLog",
                    "audit" => x.RecordType == "SecurityAuditEvent",
                    "high-critical" => x.Severity >= 2,
                    _ => true
                })
                .OrderByDescending(x => x.OccurredAt)
                .ToList();
        }
        catch (Exception ex)
        {
            if (Api.SessionExpired)
            {
                loading = false;
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            error = $"Could not load the threat timeline ({ex.GetType().Name}). Reload the page or log in again.";
            timeline = Array.Empty<UI.Services.TalonApiClient.TimelineItem>();
        }
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string MapFilter(string selectedFilter) => selectedFilter switch
    {
        "threats" => "threat",
        "audit" => "audit",
        _ => "all"
    };

    private static string SeverityName(int value) => value switch { 0 => "Low", 1 => "Medium", 2 => "High", 3 => "Critical", _ => value.ToString() };
    private static string SeverityClass(int value) => value switch { 0 => "bg-secondary", 1 => "bg-info", 2 => "bg-warning text-dark", 3 => "bg-danger", _ => "bg-secondary" };
}
