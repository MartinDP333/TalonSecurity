@page "/threatlogs"
@rendermode InteractiveServer
@inject UI.Services.TalonApiClient Api
@inject NavigationManager Navigation

<h1>Security activity</h1>
@if (!Api.IsLoggedIn)
{
    <p>Log in to view tenant activity.</p><a class="btn btn-primary" href="/login">Log in</a>
}
else if (loading) { <p>Loading tenant activity...</p> }
else if (error is not null) { <div class="alert alert-danger">@error</div> }
else
{
    <div class="card mb-3"><div class="card-body"><strong>Tenant:</strong> @Api.CurrentTenantName<br /><strong>Role:</strong> @Api.CurrentTenantRole</div></div>
    <div class="row g-2 mb-3">
        <div class="col-md-3"><label class="form-label">Activity type</label><select class="form-select" @bind="selectedType"><option value="all">Threats and audit</option><option value="threat">Threat logs</option><option value="audit">Audit events</option></select></div>
        <div class="col-md-3"><label class="form-label">Since</label><InputDate class="form-control" @bind-Value="sinceDate" /></div>
        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" @onclick="LoadAsync">Apply filters</button></div>
    </div>
    @if (items.Count == 0) { <p>No matching activity for this tenant.</p> }
    else
    {
        <table class="table table-striped"><thead><tr><th>Date</th><th>Record type</th><th>Severity</th><th>Event</th><th>Source IP</th><th>Endpoint</th><th>Count / Details</th></tr></thead><tbody>
        @foreach (var item in items)
        {
            <tr><td>@item.OccurredAt.ToLocalTime()</td><td>@item.RecordType</td><td>@SeverityName(item.Severity)</td><td>@item.EventType</td><td>@item.SourceIp</td><td>@item.RequestPath</td><td>@(item.HitCount?.ToString() ?? item.Details)</td></tr>
        }
        </tbody></table>
    }
}

@code {
    private bool loading = true;
    private string? error;
    private string selectedType = "all";
    private DateTime? sinceDate;
    private IReadOnlyList<UI.Services.TalonApiClient.TimelineItem> items = Array.Empty<UI.Services.TalonApiClient.TimelineItem>();
    private bool restored;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || restored) return;
        restored = true;
        await Api.RestoreAuthAsync();
        if (!Api.IsLoggedIn) { loading = false; Navigation.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        var result = await Api.GetTimelineAsync(selectedType, sinceDate?.Date.ToUniversalTime());
        if (result is null) error = "Could not load tenant security activity.";
        items = result ?? Array.Empty<UI.Services.TalonApiClient.TimelineItem>();
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string SeverityName(int value) => value switch { 0 => "Low", 1 => "Medium", 2 => "High", 3 => "Critical", _ => value.ToString() };
}
