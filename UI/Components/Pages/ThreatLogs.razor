@page "/threatlogs"
@rendermode InteractiveServer
@inject UI.Services.TalonApiClient Api
@inject NavigationManager Navigation

<h1>Threat logs</h1>
@if (!Api.IsLoggedIn)
{
    <p>Log in to view tenant threat logs.</p><a class="btn btn-primary" href="/login">Log in</a>
}
else if (loading) { <p>Loading threat logs...</p> }
else if (error is not null) { <div class="alert alert-danger">@error</div> }
else
{
    <div class="card mb-3"><div class="card-body"><strong>Tenant:</strong> @Api.CurrentTenantName<br /><strong>Role:</strong> @Api.CurrentTenantRole</div></div>
    <div class="row g-2 mb-3">
        <div class="col-md-3"><label class="form-label">Since</label><InputDate class="form-control" @bind-Value="sinceDate" /></div>
        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" @onclick="LoadAsync">Apply filter</button></div>
    </div>
    @if (threats.Count == 0) { <p>No threat logs for this tenant.</p> }
    else
    {
        <table class="table table-striped"><thead><tr><th>Last seen</th><th>Severity</th><th>Attack type</th><th>Source IP</th><th>Request path</th><th>Hit count</th><th>Country</th></tr></thead><tbody>
        @foreach (var threat in threats)
        {
            <tr><td>@threat.LastSeenAt.ToLocalTime()</td><td>@SeverityName(threat.Severity)</td><td>@threat.AttackType</td><td>@threat.SourceIp</td><td>@threat.RequestPath</td><td>@threat.HitCount</td><td>@threat.CountryCode</td></tr>
        }
        </tbody></table>
    }
}

@code {
    private bool loading = true;
    private string? error;
    private DateTime? sinceDate;
    private IReadOnlyList<UI.Services.TalonApiClient.ThreatLogView> threats = Array.Empty<UI.Services.TalonApiClient.ThreatLogView>();
    private bool restored;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || restored) return;
        restored = true;
        await Api.RestoreAuthAsync();
        if (!Api.IsLoggedIn) { loading = false; Navigation.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            threats = await Api.GetThreatLogsAsync(sinceDate?.Date)
                ?? throw new InvalidOperationException("Threat-log request failed.");
        }
        catch (Exception ex)
        {
            if (Api.SessionExpired)
            {
                loading = false;
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            error = $"Could not load threat logs ({ex.GetType().Name}). Reload the page or log in again.";
            threats = Array.Empty<UI.Services.TalonApiClient.ThreatLogView>();
        }
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string SeverityName(int value) => value switch { 0 => "Low", 1 => "Medium", 2 => "High", 3 => "Critical", _ => value.ToString() };
}
